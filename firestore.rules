rules_version = '2';
// Luật Firestore app Hán cổ tự học — nhiều người dùng (Bước 3, 26/11/2026). Bản luật cũ (chỉ chủ đọc/ghi tiến độ) cất ở
// tools/backup/20261126-211811-buoc3/firestore.rules để quay lại được.
// - Quản trị viên (mã 000) = uid ghi cứng dưới đây (giống ADMIN_UID trong app.js; uid không phải bí mật). Luôn được phép.
// - hanco_users/{uid}: hồ sơ {ten (tên hiển thị), hoten (họ tên trong danh sách), hk (khóa họ tên), email, st "ok"|"khoa"|"xoa",
//   tao, upd, tk}. Chỉ chính mình + quản trị đọc. Tự tạo khi đăng ký (đúng khuôn, email đã xác nhận, giữ tên + chỗ cùng lúc);
//   tự sửa chỉ ten/tk/upd; st chỉ quản trị đổi.
// - hanco_ten/{khóa họ tên}: {ten, uid|null, t}. Danh sách họ tên thật do quản trị dán. Không ai liệt kê được (trừ quản trị);
//   đọc 1 tên đúng như mình gõ chỉ được khi tên đó không có / còn trống / của mình (đủ để báo lỗi, không lộ thêm).
// - hanco_cfg/dk: {tran (trần số người), dem (số người đã đăng ký), mo (cho đăng ký mới)}. Ai cũng đọc; người đăng ký chỉ được
//   +1 dem khi còn chỗ và đang mở, cùng lần tạo hồ sơ của mình. Quản trị ghi tự do.
// - hanco_progress/{uid} (+ backups/): chỉ chủ tài khoản đang "ok"; quản trị đọc được mọi người, xóa được.
//   sach/ (hình sách riêng bản cũ): chỉ đọc + xóa. Hình sách nay ở kho chung hanco_sach (Bước 6): thành viên "ok" đọc, quản trị ghi.
// - hanco_qt/*: chỉ quản trị (mã số tài khoản, lịch sử người bị xóa, tự xóa, nhật ký quản trị — Bước 4).
// - hanco_cfg/chung (Bước 4): thông báo chung, ngày thi chung, cài đặt tự xóa — người đã đăng nhập đọc, chỉ quản trị ghi.
// - tk (Bước 4) = bản thống kê tóm tắt người học tự gửi (≤ 1 lần/giờ): phải là map đúng các khóa đã định.
// - hanco_bxh (Bước 7) = bảng xếp hạng: tong (cả bảng 1 tài liệu, mỗi người sửa đúng dòng của mình) + c<tuần> (bản chốt cúp tuần).
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && request.auth.uid == 'PoB9oWSF4WRAPkWYtKaXfAHSX7F3'; }
    function me(uid) { return signed() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/hanco_users/$(uid); }
    function tenPath(k) { return /databases/$(database)/documents/hanco_ten/$(k); }
    function cfgPath() { return /databases/$(database)/documents/hanco_cfg/dk; }
    // chủ tài khoản được dùng tiến độ: quản trị, hoặc hồ sơ đang "ok"
    function owner(uid) { return me(uid) && (isAdmin() || (exists(userPath(uid)) && get(userPath(uid)).data.st == 'ok')); }
    function tenOk(t) { return t is string && t.size() >= 2 && t.size() <= 30; }

    match /hanco_progress/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow create, update: if owner(uid);
      allow delete: if owner(uid) || isAdmin();
      match /backups/{day} {
        allow read: if owner(uid) || isAdmin();
        allow create, update: if owner(uid);
        allow delete: if owner(uid) || isAdmin();
      }
      // hình trang sách RIÊNG (bản cũ, trước kho chung hanco_sach — Bước 6): chỉ còn đọc + xóa, KHÔNG ai ghi mới
      match /sach/{k} {
        allow read, delete: if owner(uid) || isAdmin();
      }
    }

    match /hanco_users/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create: if isAdmin() || (me(uid) && regOk(uid));
      allow update: if isAdmin() || (me(uid) && resource.data.st == 'ok'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ten', 'tk', 'upd'])
        && tenOk(request.resource.data.ten)
        && (!('tk' in request.resource.data) || tkOk(request.resource.data.tk)));
      function tkOk(t) {
        // q = bộ đếm hạn mức từng máy {mã máy: số đếm} (Bước 5, tối đa 6 máy), nb = số bản sao lưu
        return t is map && t.keys().hasOnly(['v', 't', 'd', 'last', 'sc', 'sd', 'xp', 'xw', 'la', 'lx', 'n', 'due', 'ky', 'ex', 'hq', 'sz', 'q', 'nb'])
          && (!('q' in t) || (t.q is map && t.q.size() <= 6)) && (!('nb' in t) || t.nb is int)
          && (!('la' in t) || (t.la is list && t.la.size() <= 31)) && (!('lx' in t) || (t.lx is list && t.lx.size() <= 31))
          && (!('ky' in t) || (t.ky is list && t.ky.size() <= 12)) && (!('hq' in t) || (t.hq is list && t.hq.size() <= 10));
      }
      allow delete: if isAdmin();

      // đăng ký: email đã xác nhận, đúng khuôn, giữ đúng 1 tên còn trống trong danh sách, +1 số người khi còn chỗ — cùng 1 lần ghi
      function regOk(uid) {
        let d = request.resource.data;
        let k = d.hk;
        let c0 = get(cfgPath()).data;
        return request.auth.token.email_verified == true
          && d.keys().hasOnly(['ten', 'hoten', 'hk', 'email', 'st', 'tao', 'upd'])
          && d.keys().hasAll(['ten', 'hoten', 'hk', 'email', 'st', 'tao', 'upd'])
          && d.st == 'ok' && d.tao == request.time && d.upd is int
          && d.email == request.auth.token.email
          && tenOk(d.ten)
          && k is string && k.size() >= 2 && k.size() <= 200
          && exists(tenPath(k))
          && get(tenPath(k)).data.uid == null
          && getAfter(tenPath(k)).data.uid == uid
          && d.hoten == get(tenPath(k)).data.ten
          && c0.mo == true && c0.dem < c0.tran
          && getAfter(cfgPath()).data.dem == c0.dem + 1;
      }
    }

    match /hanco_ten/{k} {
      allow get: if isAdmin() || resource == null || resource.data.uid == null || (signed() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signed() && resource.data.uid == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 't'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t == request.time
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.hk == k);
    }

    match /hanco_cfg/{k} {
      allow read: if k == 'dk' || signed();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (k == 'dk' && signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dem'])
        && resource.data.mo == true && resource.data.dem < resource.data.tran
        && request.resource.data.dem == resource.data.dem + 1
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.hk is string);
    }

    // KHO HÌNH SÁCH CHUNG (Bước 6): p<vị trí> = {b (PNG base64), vt, upd}; info = {sz {vị trí: độ dài b}, upd}.
    // Thành viên đang "ok" + quản trị đọc; chỉ quản trị ghi/xóa, đúng khuôn, giới hạn kích thước.
    match /hanco_sach/{k} {
      allow read: if isAdmin() || (signed() && exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.st == 'ok');
      allow create, update: if isAdmin() && sachOk(k, request.resource.data);
      allow delete: if isAdmin();
      function sachOk(k, d) {
        return (k == 'info' && d.keys().hasOnly(['sz', 'upd']) && d.sz is map && d.sz.size() <= 1000 && d.upd is int)
          || (k != 'info' && d.keys().hasOnly(['b', 'vt', 'upd']) && d.keys().hasAll(['b', 'vt'])
            && d.vt is int && d.vt > 0 && d.vt < 10000 && k == 'p' + string(d.vt)
            && d.b is string && d.b.size() > 0 && d.b.size() <= 400000 && (!('upd' in d) || d.upd is int));
      }
    }

    // BẢNG XẾP HẠNG (Bước 7): tong = {u {uid: dòng}, an {uid: 1 ẩn tay | 2 đang khóa}, rs {uid: ngày đặt lại XP}} — 1 tài liệu cho cả
    // bảng (mở bảng = 1 lượt đọc). Thành viên "ok" đọc; chỉ sửa ĐÚNG dòng của mình: đúng khuôn, tên = tên hiển thị trong hồ sơ, XP
    // không tăng quá 2.000 + 0,5 XP/giây kể từ lần ghi trước, XP từng kỳ ≤ tổng, đã bị đặt lại thì phải ghi đúng ngày đặt lại.
    // an / rs / xóa dòng: chỉ quản trị. c<tuần> = bản chốt cúp tuần {k thứ Hai của tuần (số ngày), e [{u uid, v XP}] giảm dần, t}: tạo 1 lần
    // sau 12 giờ trưa thứ Hai tuần sau (giờ VN); 3 người đầu phải khớp dòng trên bảng; chỉ quản trị xóa (chốt lại).
    match /hanco_bxh/{k} {
      allow read: if isAdmin() || okSt();
      allow create: if (k == 'tong' && isAdmin())
        || (k.matches('c[0-9]+') && (isAdmin() || okSt()) && cupOk(k, request.resource.data));
      allow update: if isAdmin() || (k == 'tong' && okSt()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['u'])
        && request.resource.data.u.diff(resource.data.u).affectedKeys().hasOnly([request.auth.uid])
        && rowOk(request.resource.data.u[request.auth.uid], resource.data.u.get(request.auth.uid, null), resource.data));
      allow delete: if isAdmin();
      function okSt() { return signed() && exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.st == 'ok'; }
      function perOk(n, f) { return !(f in n) || (n[f] is list && n[f].size() == 2 && n[f][0] is int && n[f][1] is int && n[f][1] >= 0 && n[f][1] <= n.xp); }
      function rowOk(n, o, T) {
        return n is map
          && n.keys().hasOnly(['ten', 'xp', 'w', 'wp', 'm', 'q', 'y', 'sc', 'sd', 'sm', 'lv', 'bd', 'cp', 'rc', 'xm', 'r', 'upd'])
          && n.keys().hasAll(['ten', 'xp', 'upd'])
          && n.ten == get(userPath(request.auth.uid)).data.ten
          && n.xp is int && n.xp >= 0 && n.xp <= 100000000 && n.upd == request.time
          && perOk(n, 'w') && perOk(n, 'wp') && perOk(n, 'm') && perOk(n, 'q') && perOk(n, 'y')
          && (!('bd' in n) || (n.bd is map && n.bd.size() <= 12)) && (!('rc' in n) || (n.rc is map && n.rc.size() <= 8))
          && (!('cp' in n) || (n.cp is list && n.cp.size() <= 3))
          && (!(request.auth.uid in T.get('rs', {})) || n.get('r', 0) == T.rs[request.auth.uid])
          && (o == null || n.xp <= o.xp || n.xp - o.xp <= 2000 + (request.time.toMillis() - o.upd.toMillis()) / 2000);
      }
      function wkHas(r, wk, v) { return ('w' in r && r.w[0] == wk && r.w[1] == v) || ('wp' in r && r.wp[0] == wk && r.wp[1] == v); }
      function cupE(T, wk, e) { return e is map && e.keys().hasOnly(['u', 'v']) && e.u is string && e.v is int && e.v > 0 && e.u in T.u && !(e.u in T.get('an', {})) && wkHas(T.u[e.u], wk, e.v); }
      function cupOk(k, d) {
        let T = get(/databases/$(database)/documents/hanco_bxh/tong).data;
        return d.keys().hasOnly(['k', 'e', 't']) && d.keys().hasAll(['k', 'e', 't'])
          && d.k is int && k == 'c' + string(d.k) && d.t == request.time
          && request.time.toMillis() >= (d.k + 7) * 86400000 - 25200000 + 43200000
          && d.e is list && d.e.size() <= 300
          && (d.e.size() < 1 || cupE(T, d.k, d.e[0]))
          && (d.e.size() < 2 || (cupE(T, d.k, d.e[1]) && d.e[1].v <= d.e[0].v && d.e[1].u != d.e[0].u))
          && (d.e.size() < 3 || (cupE(T, d.k, d.e[2]) && d.e[2].v <= d.e[1].v && d.e[2].u != d.e[1].u && d.e[2].u != d.e[0].u));
      }
    }

    // CÁCH NHỚ CHUNG (Bước 8): hanco_meo/{id mục}_{uid tác giả} = {id, uid, ten (= tên hiển thị trong hồ sơ), h (HTML, 1–8.000 ký tự), upd (giờ máy chủ),
    // r {uid người chấm: 1–5}}. Thành viên "ok" đọc / truy vấn. Tác giả tạo (r rỗng hoặc không có) + sửa h/ten/upd + xóa; người khác chỉ sửa / bỏ
    // ĐÚNG r.<uid mình> (không chấm của chính mình); quản trị xóa. hanco_bao/{mã cách nhớ}_{uid người báo} = {m, id, a, u, ly, t}: thành viên "ok" chỉ
    // TẠO (1 lần / cách nhớ, không báo của mình, phải khớp cách nhớ đang có); không ai sửa; chỉ quản trị đọc + xóa.
    function okMe() { return signed() && exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.st == 'ok'; }
    function meoTen(t) { return isAdmin() || t == get(userPath(request.auth.uid)).data.ten; }
    match /hanco_meo/{k} {
      allow read: if isAdmin() || okMe();
      allow create: if (isAdmin() || okMe()) && meoNew(k, request.resource.data);
      allow update: if (isAdmin() || okMe()) && (meoEdit(resource.data, request.resource.data) || meoRate(resource.data, request.resource.data));
      allow delete: if isAdmin() || (okMe() && (resource == null || resource.data.uid == request.auth.uid));
      function meoH(d) { return d.h is string && d.h.size() > 0 && d.h.size() <= 8000 && meoTen(d.ten) && tenOk(d.ten) && d.upd == request.time; }
      function meoNew(k, d) {
        return d.keys().hasOnly(['id', 'uid', 'ten', 'h', 'upd', 'r']) && d.keys().hasAll(['id', 'uid', 'ten', 'h', 'upd'])
          && d.uid == request.auth.uid && d.id is string && d.id.matches('[cwsr][0-9]{1,6}') && k == d.id + '_' + request.auth.uid
          && (!('r' in d) || (d.r is map && d.r.size() == 0)) && meoH(d);
      }
      function meoEdit(o, d) {
        return o.uid == request.auth.uid && d.diff(o).affectedKeys().hasOnly(['h', 'ten', 'upd']) && meoH(d);
      }
      function meoRate(o, d) {
        return o.uid != request.auth.uid && d.diff(o).affectedKeys().hasOnly(['r'])
          && d.r.diff(o.get('r', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in d.r) || (d.r[request.auth.uid] is int && d.r[request.auth.uid] >= 1 && d.r[request.auth.uid] <= 5))
          && d.r.size() <= 500;
      }
    }
    match /hanco_bao/{k} {
      allow read, delete: if isAdmin();
      allow create: if okMe() && baoOk(k, request.resource.data);
      function baoOk(k, d) {
        let mp = /databases/$(database)/documents/hanco_meo/$(d.m);
        return d.keys().hasOnly(['m', 'id', 'a', 'u', 'ly', 't']) && d.keys().hasAll(['m', 'id', 'a', 'u', 'ly', 't'])
          && d.u == request.auth.uid && k == d.m + '_' + request.auth.uid && d.t == request.time
          && d.m is string && d.ly is string && d.ly.size() <= 300
          && exists(mp) && get(mp).data.uid == d.a && get(mp).data.id == d.id && d.a != request.auth.uid;
      }
    }

    match /hanco_qt/{doc=**} {
      allow read, write: if isAdmin();
    }
  }
}
